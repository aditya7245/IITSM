@startuml 11-er-diagram
!include _style.iuml
title Database design (PostgreSQL, from V1__baseline_schema.sql)
skinparam linetype ortho
hide circle

entity users {
  * id : BIGINT <<PK>>
  --
  * role : VARCHAR(30)
  * email : VARCHAR(150) <<UQ>>
  * password_hash : VARCHAR(100)
  * full_name : VARCHAR(120)
  * active : BOOLEAN
  department : VARCHAR(100)
  team_id : BIGINT <<FK>>
  max_workload : INT
  available : BOOLEAN
  experience_years : INT
}
entity teams {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<UQ>>
  lead_id : BIGINT <<FK>>
}
entity skills {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(80) <<UQ>>
}
entity technician_skills {
  * technician_id : BIGINT <<PK,FK>>
  * skill_id : BIGINT <<PK,FK>>
  --
  * proficiency : SMALLINT (1–5)
}
entity categories {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(80) <<UQ>>
  description : VARCHAR(255)
  * keywords : TEXT
  required_skill_id : BIGINT <<FK>>
  * active : BOOLEAN
}
entity it_services {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(120) <<UQ>>
  description : VARCHAR(255)
  * business_criticality : SMALLINT (1–5)
  * active : BOOLEAN
}
entity sla_policies {
  * id : BIGINT <<PK>>
  --
  * priority : VARCHAR(2)
  service_id : BIGINT <<FK>> (NULL = default)
  * response_minutes : INT
  * resolution_minutes : INT
}
entity incidents {
  * id : BIGINT <<PK>>
  --
  * incident_number : VARCHAR(20) <<UQ>>
  * title : VARCHAR(200)
  * description : TEXT
  * reporter_id : BIGINT <<FK>>
  category_id : BIGINT <<FK>>
  * service_id : BIGINT <<FK>>
  assignee_id : BIGINT <<FK>>
  * impact, urgency : SMALLINT (1–3)
  * affected_users : INT
  priority_score : INT
  priority : VARCHAR(2)
  * status : VARCHAR(20)
  * sla_status : VARCHAR(10)
  response_deadline, resolution_deadline : TIMESTAMPTZ
  sla_paused_at : TIMESTAMPTZ
  * sla_paused_seconds : BIGINT
  * escalation_level : SMALLINT
  duplicate_of_id : BIGINT <<FK>>
  resolution : TEXT
  responded_at, resolved_at, closed_at : TIMESTAMPTZ
}
entity incident_comments {
  * id : BIGINT <<PK>>
  --
  * incident_id : BIGINT <<FK>>
  * author_id : BIGINT <<FK>>
  * type : NOTE | INFO_REQUEST | INFO_RESPONSE
  * body : TEXT
}
entity audit_logs {
  * id : BIGINT <<PK>>
  --
  incident_id : BIGINT <<FK>>
  user_id : BIGINT <<FK>> (NULL = system)
  * action : VARCHAR(60)
  previous_state, new_state : VARCHAR(20)
  description : TEXT
  * created_at : TIMESTAMPTZ
}
entity notifications {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  incident_id : BIGINT <<FK>>
  * event_type : VARCHAR(40)
  * message : VARCHAR(500)
  * is_read : BOOLEAN
}
entity feedback {
  * id : BIGINT <<PK>>
  --
  * incident_id : BIGINT <<FK,UQ>>
  * rating : SMALLINT (1–5)
  comments : TEXT
}
entity system_config {
  * config_key : VARCHAR(80) <<PK>>
  --
  * config_value : VARCHAR(255)
  description : VARCHAR(255)
}

teams |o--o{ users : members
teams |o--o| users : lead
users ||--o{ technician_skills
skills ||--o{ technician_skills
skills |o--o{ categories : required skill
it_services |o--o{ sla_policies : override
users ||--o{ incidents : reports
users |o--o{ incidents : assigned
categories |o--o{ incidents
it_services ||--o{ incidents
incidents |o--o{ incidents : duplicate of
incidents ||--o{ incident_comments
users ||--o{ incident_comments : author
incidents |o--o{ audit_logs
users |o--o{ audit_logs
users ||--o{ notifications
incidents |o--o{ notifications
incidents ||--o| feedback
@enduml
